---
import MainLayout from "../../layouts/MainLayout.astro";
import AdminSidebar from "../../components/admin/AdminSidebar.astro";
import StatsCard from "../../components/admin/StatsCard.astro";
import ProductManagementTable from "../../components/admin/ProductManagementTable.astro";
import NewProductForm from "../../components/admin/NewProductForm.astro";
import { products, adminStats } from "../../data/products";
---

<MainLayout title="Panel de Administración | BioRaíz Naturista">
  <div class="min-h-screen flex flex-col lg:flex-row bg-stone-100/80">
    <!-- 1. Barra Lateral de Administración -->
    <AdminSidebar activeSection="inventario" />

    <!-- 2. Área de Contenido Principal -->
    <div class="flex-1 flex flex-col min-w-0">
      <!-- Barra Superior del Dashboard -->
      <header class="bg-white border-b border-stone-200 px-6 py-4 flex flex-wrap items-center justify-between gap-4 sticky top-0 z-30">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-700">
            Panel de Control Interno · Distribuidora BioRaíz
          </span>
          <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900">
            Bienvenida, Elena 👋
          </h1>
        </div>

        <div class="flex items-center gap-3">
          <a
            href="/"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-stone-300 bg-white hover:bg-stone-50 text-slate-700 font-semibold text-xs sm:text-sm transition-colors"
          >
            <span>Ver Tienda Cliente</span>
            <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>

          <a
            href="#alta-producto"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs sm:text-sm shadow-sm transition-colors"
          >
            <span>+ Nuevo Producto</span>
          </a>
        </div>
      </header>

      <!-- Cuerpo del Dashboard -->
      <main class="p-6 sm:p-8 space-y-8 max-w-7xl w-full mx-auto">
        <!-- Tarjetas de Resumen Superior usando StatsCard.astro -->
        <section aria-label="Resumen de métricas del negocio">
          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">
            {adminStats.map((stat) => <StatsCard stat={stat} />)}
          </div>
        </section>

        <!-- Tabla de Gestión de Productos con Botón "+ Nuevo Producto" -->
        <ProductManagementTable products={products} />

        <!-- Sección de Alta de Producto con Precios de Menudeo y Mayoreo -->
        <NewProductForm />
      </main>
    </div>
  </div>
</MainLayout>

<script>
  // Lógica interactiva para calcular margen en vivo y simular el alta de un nuevo producto
  const retailInput = document.getElementById("prod-retail") as HTMLInputElement | null;
  const wholesaleInput = document.getElementById("prod-wholesale") as HTMLInputElement | null;
  const marginPreview = document.getElementById("live-margin-preview");
  const profitUnit = document.getElementById("live-profit-unit");
  const openModalBtn = document.getElementById("open-new-product-modal-btn");
  const altaSection = document.getElementById("alta-producto");
  const nameInput = document.getElementById("prod-name") as HTMLInputElement | null;
  const form = document.getElementById("new-product-form") as HTMLFormElement | null;
  const tbody = document.getElementById("admin-products-tbody");
  const feedback = document.getElementById("form-feedback");

  function updateMarginPreview() {
    const retail = Number(retailInput?.value || 0);
    const wholesale = Number(wholesaleInput?.value || 0);
    if (retail > 0 && wholesale > 0 && retail >= wholesale) {
      const pct = Math.round(((retail - wholesale) / retail) * 100);
      const diff = retail - wholesale;
      if (marginPreview) marginPreview.textContent = `${pct}% ahorro`;
      if (profitUnit) profitUnit.textContent = `Ganancia: $${diff} MXN / pza`;
    } else {
      if (marginPreview) marginPreview.textContent = "Revisar precios";
      if (profitUnit) profitUnit.textContent = "Mayoreo debe ser menor";
    }
  }

  retailInput?.addEventListener("input", updateMarginPreview);
  wholesaleInput?.addEventListener("input", updateMarginPreview);

  // Al hacer clic en "+ Nuevo Producto" en la tabla, desplazar suavemente al formulario y enfocar
  openModalBtn?.addEventListener("click", () => {
    altaSection?.scrollIntoView({ behavior: "smooth", block: "center" });
    setTimeout(() => nameInput?.focus(), 400);
  });

  // Agregar fila en vivo a la tabla cuando la dueña guarda un producto nuevo
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const name = String(formData.get("name") || "Nuevo Producto Naturista");
    const category = String(formData.get("category") || "Superalimentos");
    const presentation = String(formData.get("presentation") || "Frasco 60 cápsulas");
    const retailPrice = Number(formData.get("retailPrice") || 250);
    const wholesalePrice = Number(formData.get("wholesalePrice") || 175);
    const minQty = Number(formData.get("minWholesaleQty") || 6);
    const stock = Number(formData.get("stock") || 50);
    const marginPercent = Math.max(
      0,
      Math.round(((retailPrice - wholesalePrice) / retailPrice) * 100)
    );
    const randomSku = `NAT-NEW-${Math.floor(100 + Math.random() * 900)}`;

    if (tbody) {
      const tr = document.createElement("tr");
      tr.className = "bg-emerald-50/70 hover:bg-emerald-100/50 transition-colors";
      tr.innerHTML = `
        <td class="py-4 px-6">
          <div class="flex items-center gap-3.5">
            <div class="w-12 h-12 rounded-xl bg-emerald-600 text-white font-extrabold text-xs flex items-center justify-center shrink-0">
              NUEVO
            </div>
            <div>
              <p class="font-bold text-slate-900">${name}</p>
              <p class="text-xs text-slate-500">${presentation}</p>
            </div>
          </div>
        </td>
        <td class="py-4 px-4">
          <span class="inline-block text-xs font-semibold text-emerald-800 bg-emerald-100 px-2.5 py-0.5 rounded-md">${category}</span>
          <span class="block text-xs font-mono text-slate-400 mt-1">${randomSku}</span>
        </td>
        <td class="py-4 px-4">
          <span class="font-bold text-slate-800 text-base">$${retailPrice}.00</span>
          <span class="block text-[11px] text-slate-400">Público general</span>
        </td>
        <td class="py-4 px-4">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-emerald-100 border border-emerald-300">
            <span class="font-extrabold text-emerald-800 text-base">$${wholesalePrice}.00</span>
            <span class="text-[11px] font-bold text-emerald-900 bg-emerald-200 px-1.5 py-0.5 rounded">-${marginPercent}%</span>
          </div>
          <span class="block text-[11px] text-slate-500 mt-1">Mínimo ${minQty} pzas</span>
        </td>
        <td class="py-4 px-4">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="font-semibold text-slate-700">${stock} u.</span>
          </div>
        </td>
        <td class="py-4 px-6 text-right">
          <span class="px-3 py-1.5 rounded-lg text-xs font-bold text-emerald-800 bg-emerald-200/70">Recién creado</span>
        </td>
      `;
      tbody.prepend(tr);
    }

    feedback?.classList.remove("hidden");
    document.getElementById("tabla-productos")?.scrollIntoView({ behavior: "smooth" });
  });
</script>

