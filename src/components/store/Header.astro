---
interface Props {
  activePage?: "store" | "admin";
}

const { activePage = "store" } = Astro.props;
---

<header class="sticky top-0 z-40 w-full bg-white/90 backdrop-blur-md border-b border-emerald-100/80 shadow-xs">
  <!-- Barra superior informativa para mayoristas -->
  <div class="bg-emerald-950 text-emerald-50 text-xs py-2 px-4">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <p class="flex items-center gap-2 font-medium">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>🌿 Precio especial de <strong>Mayoreo</strong> desde 6 piezas por producto · Envíos a todo el país</span>
      </p>
      <div class="flex items-center gap-4">
        <a href="#beneficios-mayoreo" class="hover:text-emerald-300 underline underline-offset-2 transition-colors">
          Programa Distribuidores
        </a>
        <span class="text-emerald-700">|</span>
        <a href="/admin" class="inline-flex items-center gap-1 text-emerald-300 hover:text-white font-semibold transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Panel de Administración
        </a>
      </div>
    </div>
  </div>

  <!-- Navegación principal -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none">
      <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-emerald-600 to-emerald-800 flex items-center justify-center text-white shadow-md shadow-emerald-600/20 group-hover:scale-105 transition-transform">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <div>
        <span class="text-xl font-extrabold tracking-tight text-emerald-950 block leading-none">
          Bio<span class="text-emerald-600">Raíz</span>
        </span>
        <span class="text-[11px] font-semibold uppercase tracking-widest text-emerald-700/80 block mt-0.5">
          Distribuidora Naturista
        </span>
      </div>
    </a>

    <!-- Enlaces centrales -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-600">
      <a href="#catalogo" class="hover:text-emerald-700 transition-colors">Catálogo</a>
      <a href="#beneficios-mayoreo" class="hover:text-emerald-700 transition-colors">Precios Mayoreo</a>
      <a href="#calidad" class="hover:text-emerald-700 transition-colors">Certificaciones</a>
    </nav>

    <!-- Acciones Derecha: Buscador + Carrito -->
    <div class="flex items-center gap-3">
      <div class="hidden sm:flex items-center bg-stone-100 hover:bg-stone-200/70 focus-within:bg-white focus-within:ring-2 focus-within:ring-emerald-500 rounded-xl px-3.5 py-2 transition-all border border-stone-200/80">
        <svg class="w-4 h-4 text-slate-400 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="search"
          id="store-search"
          placeholder="Buscar moringa, colágeno..."
          class="bg-transparent text-sm text-slate-700 placeholder:text-slate-400 focus:outline-none w-44 lg:w-56"
        />
      </div>

      <!-- Botón del Carrito -->
      <button
        type="button"
        id="cart-btn"
        aria-label="Ver carrito de compras"
        class="relative inline-flex items-center gap-2.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-900 font-semibold px-4 py-2.5 rounded-xl border border-emerald-200/80 transition-all cursor-pointer active:scale-95"
      >
        <svg class="w-5 h-5 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <span class="hidden sm:inline text-sm">Carrito</span>
        <span
          id="cart-count-badge"
          class="inline-flex items-center justify-center min-w-5 h-5 px-1.5 text-xs font-bold bg-emerald-600 text-white rounded-full shadow-xs"
        >
          2
        </span>
      </button>
    </div>
  </div>
</header>

