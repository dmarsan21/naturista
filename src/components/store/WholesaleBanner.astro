            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <h3 class="text-base font-bold text-white">Calidad Herbolaria Pura</h3>
          <p class="text-sm text-emerald-100/80 mt-1 leading-relaxed">
            Materias primas seleccionadas sin rellenos artificiales, con lote y fecha de caducidad amplia de hasta 24 meses.
          </p>
        </div>
      </div>

      <div class="bg-emerald-800/50 border border-emerald-700/60 rounded-2xl p-6 flex items-start gap-4">
        <div class="w-12 h-12 rounded-xl bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center shrink-0 text-emerald-300">
